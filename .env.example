# FitCheck build settings. All optional; leave a value empty to turn that feature off.
# Every VITE_ value is copied into the public JavaScript bundle: never put secrets here.

# Custom Fit waitlist form (https:// only). The Custom Fit section is always shown;
# this only controls the waitlist button.
VITE_WAITLIST_URL=

# Feedback form (https:// only). Controls the "Send feedback" link.
VITE_FEEDBACK_URL=

# Plausible site domain, exactly as registered in Plausible. Empty = no analytics.
VITE_PLAUSIBLE_DOMAIN=

# Leave empty to use https://plausible.io/js/script.js.
# Do not use Plausible's per-site pa-….js script here (it needs plausible.init()).
VITE_PLAUSIBLE_SRC=
